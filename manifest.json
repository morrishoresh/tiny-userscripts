{
  "manifest_version": 3,
  "name": "Tiny Userscripts",
  "version": "1.1.1",
  "description": "A minimal userscript manager: install, enable and remove userscripts, with a small async GM API.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "meta.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Tiny Userscripts",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "131",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-userscripts@mh",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
